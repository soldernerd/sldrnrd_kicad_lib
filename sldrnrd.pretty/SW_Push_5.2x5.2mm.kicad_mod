(module SW_Push_5.2x5.2mm (layer F.Cu) (tedit 20211014)
  (descr "SMD tactile pushbutton, 5.1x5.1x1.5mm body, 4 pads (XKB TS-1187A-B-A-B and compatible)")
  (tags "switch tactile SMD pushbutton")
  (attr smd)

  (fp_text reference REF** (at 0 -3.6) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value SW_Push_5.2x5.2mm (at 0 3.6) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "${REFERENCE}" (at 0 0) (layer F.Fab)
    (effects (font (size 0.5 0.5) (thickness 0.08)))
  )

  ; Body outline (5.1 x 5.1mm) on F.Fab
  (fp_line (start -2.55 -2.55) (end  2.55 -2.55) (layer F.Fab) (width 0.10))
  (fp_line (start  2.55 -2.55) (end  2.55  2.55) (layer F.Fab) (width 0.10))
  (fp_line (start  2.55  2.55) (end -2.55  2.55) (layer F.Fab) (width 0.10))
  (fp_line (start -2.55  2.55) (end -2.55 -2.55) (layer F.Fab) (width 0.10))

  ; Silkscreen outside courtyard
  (fp_line (start -2.55 -2.65) (end  2.55 -2.65) (layer F.SilkS) (width 0.12))
  (fp_line (start -2.55  2.65) (end  2.55  2.65) (layer F.SilkS) (width 0.12))

  ; Courtyard
  (fp_line (start -3.75 -2.55) (end  3.75 -2.55) (layer F.CrtYd) (width 0.05))
  (fp_line (start  3.75 -2.55) (end  3.75  2.55) (layer F.CrtYd) (width 0.05))
  (fp_line (start  3.75  2.55) (end -3.75  2.55) (layer F.CrtYd) (width 0.05))
  (fp_line (start -3.75  2.55) (end -3.75 -2.55) (layer F.CrtYd) (width 0.05))

  ; Pads (per EasyEDA model, lead span 6.0mm centre, pin pitch Y=3.7mm)
  (pad 1 smd rect (at -3.00 -1.85) (size 1.00 0.75) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at  3.00 -1.85) (size 1.00 0.75) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at -3.00  1.85) (size 1.00 0.75) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd rect (at  3.00  1.85) (size 1.00 0.75) (layers F.Cu F.Paste F.Mask))

  (model "${SLDRNRD_LIB}/3dmodels/SW_Push_5.2x5.2mm.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
