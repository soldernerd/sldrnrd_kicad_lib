(module Bourns_3296X (layer F.Cu) (tedit 00000000)
	(descr "Bourns 3296X series, 25-turn multiturn cermet trimmer potentiometer, side-adjust, THT, 3-pin 2.54mm pitch, https://www.bourns.com/docs/product-datasheets/3296.pdf")
	(tags "trimmer potentiometer variable resistor Bourns 3296X side adjust THT")
	(attr through_hole)
	(fp_text reference REF** (at 0.00 -3.30) (layer F.SilkS)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text value Bourns_3296X (at 0.00 3.30) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(fp_text user %R (at 0.00 0.00) (layer F.Fab)
		(effects (font (size 1 1) (thickness 0.15)))
	)

	;; Body outline (9.53 x 4.83mm square Trimpot case), F.Fab
	(fp_line (start -4.765 -2.415) (end  4.765 -2.415) (layer F.Fab) (width 0.10))
	(fp_line (start  4.765 -2.415) (end  4.765  2.415) (layer F.Fab) (width 0.10))
	(fp_line (start  4.765  2.415) (end -4.765  2.415) (layer F.Fab) (width 0.10))
	(fp_line (start -4.765  2.415) (end -4.765 -2.415) (layer F.Fab) (width 0.10))

	;; Side-adjust slot housing bump, beyond CCW (pin 1) end, F.Fab
	(fp_line (start -6.000 -1.000) (end -4.765 -1.000) (layer F.Fab) (width 0.10))
	(fp_line (start -4.765 -1.000) (end -4.765  1.000) (layer F.Fab) (width 0.10))
	(fp_line (start -4.765  1.000) (end -6.000  1.000) (layer F.Fab) (width 0.10))
	(fp_line (start -6.000  1.000) (end -6.000 -1.000) (layer F.Fab) (width 0.10))
	(fp_line (start -6.000  0.000) (end -5.400  0.000) (layer F.Fab) (width 0.10))

	;; Body outline, F.SilkS (offset outward from F.Fab, clear of pads)
	(fp_line (start -4.915 -2.565) (end  4.915 -2.565) (layer F.SilkS) (width 0.12))
	(fp_line (start  4.915 -2.565) (end  4.915  2.565) (layer F.SilkS) (width 0.12))
	(fp_line (start  4.915  2.565) (end -4.915  2.565) (layer F.SilkS) (width 0.12))
	(fp_line (start -4.915  2.565) (end -4.915 -2.565) (layer F.SilkS) (width 0.12))

	;; Side-adjust slot housing bump, F.SilkS
	(fp_line (start -6.150 -1.150) (end -4.915 -1.150) (layer F.SilkS) (width 0.12))
	(fp_line (start -4.915 -1.150) (end -4.915  1.150) (layer F.SilkS) (width 0.12))
	(fp_line (start -4.915  1.150) (end -6.150  1.150) (layer F.SilkS) (width 0.12))
	(fp_line (start -6.150  1.150) (end -6.150 -1.150) (layer F.SilkS) (width 0.12))

	;; Pin 1 (CCW) identifier dot, F.SilkS
	(fp_circle (center -2.54 1.90) (end -2.34 1.90) (layer F.SilkS) (width 0.20))

	;; Pads: 1=CCW, 2=Wiper, 3=CW, 2.54mm pitch, round THT
	(pad 1 thru_hole circle (at -2.54 0.00) (size 1.50 1.50) (drill 0.80) (layers *.Cu *.Mask))
	(pad 2 thru_hole circle (at  0.00 0.00) (size 1.50 1.50) (drill 0.80) (layers *.Cu *.Mask))
	(pad 3 thru_hole circle (at  2.54 0.00) (size 1.50 1.50) (drill 0.80) (layers *.Cu *.Mask))

	(fp_line (start -6.25 -2.80) (end  5.20 -2.80) (layer F.CrtYd) (width 0.05))
	(fp_line (start  5.20 -2.80) (end  5.20  2.80) (layer F.CrtYd) (width 0.05))
	(fp_line (start  5.20  2.80) (end -6.25  2.80) (layer F.CrtYd) (width 0.05))
	(fp_line (start -6.25  2.80) (end -6.25 -2.80) (layer F.CrtYd) (width 0.05))

	(model "../3dmodels/Bourns_3296X.step"
		(offset (xyz 2.540 0.000 0.000))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0))
	)
)
